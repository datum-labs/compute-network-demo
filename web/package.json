{
  "name": "datum-global-mesh-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs');for(const p of ['../internal/site/dist/assets','../internal/site/dist/index.html','../internal/site/dist/world-map-dots.svg'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "tsc --noEmit -p . && npm run clean && vite build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@datum-cloud/datum-ui": "^2.10.0",
    "d3-geo": "^3.1.1",
    "motion": "^13.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
